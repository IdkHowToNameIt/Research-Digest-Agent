# Chiave per la modalità AGENTE (l'LLM). In demo non serve.
OPENAI_API_KEY=metti-qui-la-tua-chiave

# Non caricare questo file su GitHub.
# Se una chiave finisce online per errore, revocala subito e creane una nuova.

# Per usare un altro provider (es. Anthropic) via LiteLLM (opzionale):
#   pip install "openai-agents[litellm]"
# e imposta in config.yaml un modello attuale del provider scelto, con la sua chiave:
# ANTHROPIC_API_KEY=...
