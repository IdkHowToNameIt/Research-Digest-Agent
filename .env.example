# Chiave per la sintesi con modello (OpenRouter). Obbligatoria per eseguire main.py.
# Creane una gratis su https://openrouter.ai/keys (accesso a piu' modelli ':free').
OPENROUTER_API_KEY=metti-qui-la-tua-chiave

# Invio email via SMTP (Gmail). Se SMTP_USER/SMTP_PASS mancano, le email vengono
# solo stampate a log (nessun invio). Con Gmail SMTP_PASS è una APP PASSWORD a 16
# cifre (Account Google → Sicurezza → Verifica in due passaggi → Password per le app),
# NON la password normale dell'account.
SMTP_USER=tuoindirizzo@gmail.com
SMTP_PASS=app-password-16-cifre
# Facoltativi (default Gmail): SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_FROM=<SMTP_USER>

# Non caricare questo file su GitHub.
# Se una chiave/password finisce online per errore, revocala subito e creane una nuova.
