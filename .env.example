# Chiave per la sintesi con modello (Groq). Obbligatoria per eseguire main.py.
# Creane una gratis su https://console.groq.com/keys (free tier ampio).
GROQ_API_KEY=metti-qui-la-tua-chiave

# Destinatari delle email, separati da virgola. DIGEST_RECIPIENTS è obbligatoria
# (il run fallisce senza). INTERNAL_NOTES_RECIPIENTS serve solo nei run che
# producono note interne: è una lista separata perché le note operative non devono
# mai raggiungere i lettori del digest.
DIGEST_RECIPIENTS=lettore1@example.com,lettore2@example.com
INTERNAL_NOTES_RECIPIENTS=comparto-it@example.com

# URL pubblico del sito: è il link che l'email manda ai lettori. Ha la precedenza
# su sito.homepage_url di config.yaml, così non serve modificare il repo.
# Su GitHub va nella scheda Variables (non è un segreto), non nei Secrets.
HOMEPAGE_URL=https://il-tuo-sito.example.com

# Invio email via SMTP (Gmail). Se SMTP_USER/SMTP_PASS mancano, le email vengono
# solo stampate a log (nessun invio). Con Gmail SMTP_PASS è una APP PASSWORD a 16
# cifre (Account Google → Sicurezza → Verifica in due passaggi → Password per le app),
# NON la password normale dell'account.
SMTP_USER=tuoindirizzo@gmail.com
SMTP_PASS=app-password-16-cifre
# Facoltativi (default Gmail): SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_FROM=<SMTP_USER>

# Non caricare questo file su GitHub.
# Se una chiave/password finisce online per errore, revocala subito e creane una nuova.
